[Unit]
Description=P2PFlow local NATS event bus
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/nats-server -a 127.0.0.1 -p 4222
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
