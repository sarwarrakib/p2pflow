# P2PFlow 2.0.8 split-domain deployment example
# Replace example.com before use. The example assumes one SAN certificate whose Certbot name is app.example.com.
# Recommended browser topology:
#   app.example.com   -> Web UI + same-origin /api proxy
#   admin.example.com -> Optional dedicated Super Admin hostname + same-origin /api proxy
#   api.example.com   -> API-only hostname for Android/integrations
# All three proxy to the same internal Go API/web binary by default.

upstream p2pflow_backend {
    keepalive 64;
    server 127.0.0.1:8080;
    # Add more healthy API/web instances here when scaling horizontally.
}

server {
    listen 80;
    server_name app.example.com admin.example.com api.example.com;
    return 301 https://$host$request_uri;
}

# Main customer/workspace web application.
server {
    listen 443 ssl http2;
    server_name app.example.com;

    ssl_certificate /etc/letsencrypt/live/app.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.example.com/privkey.pem;
    client_max_body_size 12m;

    # Long-lived realtime event stream.
    location = /api/events {
        proxy_pass http://p2pflow_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    # Keep browser API calls same-origin. This avoids cross-origin cookie/CSRF/CORS
    # complexity while still exposing api.example.com separately for native clients.
    location / {
        proxy_pass http://p2pflow_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
    }
}

# Optional dedicated Super Admin hostname. The application still performs the
# actual Owner/Super-Admin authorization; Nginx is only a hostname boundary.
server {
    listen 443 ssl http2;
    server_name admin.example.com;

    ssl_certificate /etc/letsencrypt/live/app.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.example.com/privkey.pem;
    client_max_body_size 12m;

    location = /api/events {
        proxy_pass http://p2pflow_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location / {
        proxy_pass http://p2pflow_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
    }
}

# API-only public hostname for Android/native clients or trusted integrations.
# It intentionally does not serve the dashboard/static web application.
server {
    listen 443 ssl http2;
    server_name api.example.com;

    ssl_certificate /etc/letsencrypt/live/app.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.example.com/privkey.pem;
    client_max_body_size 12m;

    location = /healthz {
        proxy_pass http://p2pflow_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /ready {
        proxy_pass http://p2pflow_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/events {
        proxy_pass http://p2pflow_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location ^~ /api/ {
        proxy_pass http://p2pflow_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
    }

    location / {
        return 404;
    }
}
