# P2PFlow local-safe example using MariaDB/MySQL.
NODE_ENV=development
PORT=3000
P2PFLOW_BIND_HOST=127.0.0.1
P2PFLOW_PRODUCTION_STRICT=false
P2PFLOW_PUBLIC_BASE_URL=http://localhost:3000
P2PFLOW_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
P2PFLOW_TRUST_PROXY=none
P2PFLOW_PUBLIC_HEALTH_DETAILS=true
P2PFLOW_DATABASE_PROVIDER=mysql
P2PFLOW_DATABASE_URL=mysql://p2pflow:p2pflow@127.0.0.1:3306/p2pflow
P2PFLOW_DATABASE_TABLE=p2pflow_state
P2PFLOW_DB_HISTORY_LIMIT=3
P2PFLOW_DB_HISTORY_INTERVAL_MS=21600000
P2PFLOW_DB_HISTORY_CLEANUP_BATCH=3
P2PFLOW_DB_BACKUP_LIMIT=5
P2PFLOW_APP_KEY=local-development-key-change-before-production-123456
P2PFLOW_SECRET_VAULT_KEY=local-secret-vault-key-change-before-production-654321
P2PFLOW_FRESH_INSTALL=true
P2PFLOW_OWNER_USERNAME=owner
P2PFLOW_OWNER_NAME=Owner
P2PFLOW_OWNER_EMAIL=owner@example.com
P2PFLOW_OWNER_PASSWORD=ChangeThisStrongPassword123!
P2PFLOW_OWNER_SECRET_CODE=739251
P2PFLOW_MAIL_DRIVER=local
P2PFLOW_MAIL_FROM_NAME=P2PFlow

P2PFLOW_SESSION_COOKIE_SAMESITE=Strict
P2PFLOW_MAX_SSE_CONNECTIONS_PER_USER=5
P2PFLOW_LOGIN_WINDOW_MS=900000
P2PFLOW_LOGIN_MAX_ATTEMPTS=12
P2PFLOW_AUTH_RATE_LIMIT_MAX_KEYS=5000
P2PFLOW_MAX_BODY_MB=12

# Local performance defaults
P2PFLOW_BINANCE_HTTP_CONCURRENCY=8
P2PFLOW_BINANCE_HTTP_PER_KEY_CONCURRENCY=3
P2PFLOW_BINANCE_HTTP_MAX_QUEUE=600
P2PFLOW_BINANCE_ROUTINE_DETAIL_BUDGET=8
P2PFLOW_STATIC_CACHE_MB=32
P2PFLOW_STATIC_CACHE_ENTRY_KB=2048
P2PFLOW_SLOW_REQUEST_MS=2500
# Coalesce broad db_updated fallback events; targeted realtime events are immediate.
P2PFLOW_DB_UPDATED_COALESCE_MS=1200
