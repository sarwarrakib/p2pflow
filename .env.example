# P2PFlow production environment
# Direct hosting users normally do not edit this file. Deploy the Node app, open /setup,
# and complete the browser installer. P2PFlow writes the required values securely.
NODE_ENV=production
PORT=3000
# Bind only to the local reverse proxy. Public traffic should terminate at Nginx/Apache.
P2PFLOW_BIND_HOST=127.0.0.1
P2PFLOW_PRODUCTION_STRICT=true
P2PFLOW_PUBLIC_BASE_URL=https://panel.example.com
P2PFLOW_ALLOWED_HOSTS=panel.example.com
# "loopback" trusts only a reverse proxy on this server. Never use "all" in production.
P2PFLOW_TRUST_PROXY=loopback
P2PFLOW_PUBLIC_HEALTH_DETAILS=false

# Encrypted application storage.
# Default hosting choice: MariaDB 10.5 / MySQL-compatible.
P2PFLOW_DATABASE_PROVIDER=mysql
P2PFLOW_DATABASE_URL=mysql://database_user:database_password@127.0.0.1:3306/database_name
P2PFLOW_DATABASE_TABLE=p2pflow_state
P2PFLOW_DATABASE_POOL_MAX=5
P2PFLOW_DATABASE_SSL=false
P2PFLOW_DATABASE_SSL_REJECT_UNAUTHORIZED=true
P2PFLOW_INSTANCE_LOCK_KEY=p2pflow_state:single-writer
P2PFLOW_DB_HISTORY_LIMIT=3
P2PFLOW_DB_HISTORY_INTERVAL_MS=21600000
P2PFLOW_DB_HISTORY_CLEANUP_BATCH=3
P2PFLOW_DB_BACKUP_LIMIT=5

# Optional PostgreSQL example:
# P2PFLOW_DATABASE_PROVIDER=postgres
# P2PFLOW_DATABASE_URL=postgresql://database_user:database_password@127.0.0.1:5432/database_name

# Permanent encryption key. The browser installer generates this for a new database.
# Existing data requires the exact same key used by the previous installation.
P2PFLOW_APP_KEY=replace-with-at-least-32-random-characters
# Optional but recommended: separate 32+ char key for reversible credential secrets (Fund Transfer Password).
# If omitted, P2PFlow derives the field vault from P2PFLOW_APP_KEY. Keep this key permanent once secrets are saved.
P2PFLOW_SECRET_VAULT_KEY=

# First-run values. The browser installer removes the plaintext password and secret
# automatically after the first encrypted database startup succeeds.
P2PFLOW_FRESH_INSTALL=false
P2PFLOW_OWNER_USERNAME=
P2PFLOW_OWNER_NAME=Owner
P2PFLOW_OWNER_EMAIL=
P2PFLOW_OWNER_PASSWORD=
P2PFLOW_OWNER_SECRET_CODE=

# Login OTP mail delivery
P2PFLOW_MAIL_DRIVER=local
P2PFLOW_MAIL_FROM=no-reply@panel.example.com
P2PFLOW_MAIL_FROM_NAME=P2PFlow
P2PFLOW_SMTP_HOST=
P2PFLOW_SMTP_PORT=587
P2PFLOW_SMTP_SECURE=false
P2PFLOW_SMTP_STARTTLS=true
P2PFLOW_SMTP_USER=
P2PFLOW_SMTP_PASS=
P2PFLOW_SMTP_HELO=panel.example.com
# After a hosting 550/rate-overlimit response, temporarily stop retrying the same local sender quota.
P2PFLOW_LOCAL_MAIL_QUOTA_COOLDOWN_MINUTES=360

# Background Web Push for bonded devices. Keys are generated once and stored in the encrypted database when left blank.
# Keep the same VAPID key pair during server moves so existing browser subscriptions remain valid.
P2PFLOW_WEB_PUSH_SUBJECT=https://panel.example.com
P2PFLOW_WEB_PUSH_PUBLIC_KEY=
P2PFLOW_WEB_PUSH_PRIVATE_KEY=

# Optional private GitHub update service. Update checks are automatic; installation is manual.
P2PFLOW_GITHUB_REPOSITORY=OWNER/PRIVATE_REPOSITORY
P2PFLOW_GITHUB_TOKEN=READ_ONLY_PRIVATE_REPOSITORY_TOKEN
P2PFLOW_GITHUB_API_VERSION=2026-03-10
P2PFLOW_UPDATE_REQUIRE_SIGNATURE=true
P2PFLOW_UPDATE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nPASTE_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
P2PFLOW_UPDATE_MANIFEST_ASSET=p2pflow-update-manifest.json
P2PFLOW_UPDATE_SIGNATURE_ASSET=p2pflow-update-manifest.sig
P2PFLOW_UPDATE_ALLOW_PRERELEASE=false
P2PFLOW_UPDATE_MAX_PACKAGE_MB=512
P2PFLOW_UPDATE_MAX_EXTRACTED_MB=2048
P2PFLOW_UPDATE_MAX_RELEASE_FILES=100000
P2PFLOW_UPDATE_MAX_METADATA_KB=4096

# Optional managed-install layout. Direct hosting can leave these blank.
P2PFLOW_INSTALL_ROOT=
P2PFLOW_ENV_FILE=
P2PFLOW_SETUP_DIR=

# Security/session defaults
P2PFLOW_SESSION_TTL_MINUTES=120
P2PFLOW_SESSION_PERSIST_EVERY_MINUTES=5
P2PFLOW_SESSION_COOKIE_SAMESITE=Strict
P2PFLOW_TRUSTED_DEVICE_TTL_DAYS=30
P2PFLOW_LOGIN_FAILURE_EMAIL_COOLDOWN_HOURS=6
P2PFLOW_MAX_BODY_MB=12
P2PFLOW_MAX_SSE_CONNECTIONS_PER_USER=5
P2PFLOW_LOGIN_WINDOW_MS=900000
P2PFLOW_LOGIN_MAX_ATTEMPTS=12
P2PFLOW_AUTH_RATE_LIMIT_MAX_KEYS=5000

# Legacy CRM_* and provider-specific environment names remain accepted for safe upgrades.

# Performance / realtime safety (v1.7.5 defaults)
# Shared Binance request gate prevents overlapping background loops from causing rate-limit/timeout storms.
P2PFLOW_BINANCE_HTTP_CONCURRENCY=8
P2PFLOW_BINANCE_HTTP_PER_KEY_CONCURRENCY=3
P2PFLOW_BINANCE_HTTP_MAX_QUEUE=600
# Routine detail calls in the rapid smart pass; new/missing-payment orders bypass this budget.
P2PFLOW_BINANCE_ROUTINE_DETAIL_BUDGET=8
# Hot JS/CSS/HTML raw + gzip/Brotli in-memory cache.
P2PFLOW_STATIC_CACHE_MB=32
P2PFLOW_STATIC_CACHE_ENTRY_KB=2048
# Log completed application requests slower than this threshold.
P2PFLOW_SLOW_REQUEST_MS=2500
# Coalesce broad db_updated fallback events; targeted realtime events are immediate.
P2PFLOW_DB_UPDATED_COALESCE_MS=1200
