# P2PFlow 2.0.8
# The binary automatically reads ./.env. Set P2PFLOW_ENV_FILE to use another path.
P2PFLOW_VERSION=2.0.8
P2PFLOW_ENV=production
P2PFLOW_LISTEN=127.0.0.1:8080
P2PFLOW_PUBLIC_DIR=./web
P2PFLOW_MIGRATION_DIR=./migrations
P2PFLOW_UPLOAD_DIR=./data/uploads
P2PFLOW_MAX_UPLOAD_BYTES=10485760
# Browser/customer application origin. For split domains use app.example.com here.
P2PFLOW_PUBLIC_BASE_URL=https://app.example.com
P2PFLOW_INSTANCE_ID=

# The account that signs up with this email becomes platform Super Admin.
# Set this BEFORE that owner signs up.
P2PFLOW_SUPERADMIN_EMAIL=owner@example.com

# postgres | mysql | mariadb
DB_DRIVER=postgres
DB_URL='postgres://p2pflow:change-me@127.0.0.1:5432/p2pflow?sslmode=disable'
DB_MAX_OPEN=50
DB_MAX_IDLE=20
DB_CONN_MAX_LIFETIME=30m

# Required. Use 32+ random bytes in production.
APP_SECRET=replace-with-a-long-random-production-secret
COOKIE_SECURE=true
# Leave blank for host-only cookie. Use .example.com only if app/admin subdomains must share login.
COOKIE_DOMAIN=
SESSION_TTL=24h

# Database migration and worker mode.
P2PFLOW_AUTO_MIGRATE=false
P2PFLOW_WORKERS=true

# Binance C2C SAPI / realtime tuning.
BINANCE_API_BASE_URL=https://api.binance.com
P2PFLOW_BINANCE_HTTP_CONCURRENCY=12
P2PFLOW_BINANCE_HTTP_PER_KEY_CONCURRENCY=3
P2PFLOW_BINANCE_INTERACTIVE_RESERVE=3
P2PFLOW_BINANCE_ORDER_SYNC_INTERVAL=3s
P2PFLOW_BINANCE_ADS_SYNC_INTERVAL=30s
P2PFLOW_BINANCE_SYNC_MAX_PAGES=5
P2PFLOW_BINANCE_CHAT_RECONNECT_MIN=1s
P2PFLOW_BINANCE_CHAT_RECONNECT_MAX=30s

# NATS is optional on a single-process server. Leave blank unless NATS is running.
# Use a private NATS URL when API/worker processes or multiple instances are split.
NATS_URL=
# Redis is reserved for optional external cache/presence/rate-limit integrations.
REDIS_URL=

# Browser extension bridge.
P2PFLOW_EXTENSION_TOKEN=replace-with-random-extension-token
P2PFLOW_EXTENSION_POLL_SECONDS=2

# SMTP. Required if login email OTP/recovery/security-email features are enabled.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=P2PFlow

# Generic billing webhook HMAC secret. REQUIRED in production before provider
# webhooks are accepted. Header: X-P2PFlow-Signature: sha256=<hex-hmac>
BILLING_WEBHOOK_SECRET=replace-with-a-separate-random-billing-secret

# P2PFlow 2.0.8 SaaS billing lifecycle.
# manual = no redirect; invoice must be reconciled by Super Admin.
# For a hosted provider, set a provider name and an HTTPS checkout endpoint that
# accepts P2PFlow query parameters and returns the user through your provider flow.
BILLING_DEFAULT_PROVIDER=manual
BILLING_CHECKOUT_URL=
BILLING_CHECKOUT_API_KEY=
BILLING_CURRENCY=BDT
BILLING_GRACE_PERIOD=72h
BILLING_INVOICE_LEAD=168h

# Browser Web Push (RFC8291/VAPID). Generate with:
#   go run ./cmd/p2pflow-keygen vapid
# VAPID_SUBJECT must be a real contact URI such as mailto:ops@example.com.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:ops@example.com
P2PFLOW_PUSH_TTL=5m
P2PFLOW_PUSH_DELIVERY_CONCURRENCY=8

# Signed atomic System Update pipeline. Generate the Ed25519 key pair OFFLINE:
#   go run ./cmd/p2pflow-keygen release --private-out ./release-signing-private.key
# Put only the PUBLIC key on the application server. Keep the private key offline.
P2PFLOW_UPDATE_RELEASE_DIR=./data/system-updates
P2PFLOW_UPDATE_PUBLIC_KEY=
P2PFLOW_UPDATE_REQUIRE_SIGNATURE=true
P2PFLOW_UPDATE_MAX_ARTIFACT_BYTES=536870912
# Optional native-host updater. Must be an absolute path. Leave empty for manual handoff.
P2PFLOW_UPDATE_APPLY_PROGRAM=
P2PFLOW_UPDATE_CURRENT_LINK=./data/system-updates/current
